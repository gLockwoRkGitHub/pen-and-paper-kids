{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "git",
            "args": ["-C", "${CLAUDE_PROJECT_DIR}", "pull", "--rebase", "--autostash"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
